# Copy this file to .env.local for local development.
# In Vercel, set these same names under Project Settings -> Environment Variables.

# From Supabase: Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared team passwords (pick your own values)
SALES_PASSWORD=change-me-sales
PRODUCTION_PASSWORD=change-me-production

# Any long random string, used to sign the login cookie so it can't be tampered with.
# Generate one at https://randomkeygen.com or just mash the keyboard for 40+ characters.
SESSION_SECRET=change-me-to-a-long-random-string
